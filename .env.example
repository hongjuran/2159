# 디스코드 개발자 포털(https://discord.com/developers/applications)에서 발급받은 봇 토큰
DISCORD_TOKEN=

# (선택) 명령어 접두사. 기본값은 !
COMMAND_PREFIX=!

# 슬래시(/) 명령어 등록에 필요 (npm run deploy-commands 실행 시 사용)
# CLIENT_ID: 개발자 포털 > General Information > Application ID
# GUILD_ID: 디스코드 앱에서 설정 > 고급 > 개발자 모드 켠 뒤, 서버 아이콘 우클릭 > ID 복사
CLIENT_ID=
GUILD_ID=

# (선택) npm run set-profile 실행 시 사용할 봇 표시 이름. 기본값은 펭베
BOT_NAME=펭베
